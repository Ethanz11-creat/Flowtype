+                "durationMs": 1, "failureCode": NSNull(), "buildInfo": ["origin": "packaged", "metadata": metadata, "failureCode": NSNull()],
+                "appResources": true, "metalLibrary": true, "mlxOperation": true, "resolvedInsideApp": true]
