+import Foundation
+import Darwin
+
+struct BoundedCommand: Sendable {
+    let executable: URL
+    let arguments: [String]
+    let workingDirectory: URL
+    let environment: [String: String]
+    let stdoutURL: URL
+    let stderrURL: URL
+    let timeoutSeconds: Double
+}
+enum BoundedTermination: String, Codable, Sendable { case normal, signal, launchFailure, timeout }
+enum BoundedFailure: String, Codable, Sendable { case launchFailed, handshakeFailed, deadlineExceeded, childSignaled, childFailed, cleanupFailed }
+struct BoundedResult: Codable, Sendable {
+    let schemaVersion: Int
+    let exitCode: Int32?
+    let termination: BoundedTermination
+    let durationMs: Int
+    let timedOut: Bool
+    let failureCode: BoundedFailure?
+    private enum CodingKeys: String, CodingKey { case schemaVersion, exitCode, termination, durationMs, timedOut, failureCode }
+    func encode(to encoder: Encoder) throws {
+        var c = encoder.container(keyedBy: CodingKeys.self)
+        try c.encode(schemaVersion, forKey: .schemaVersion); try c.encode(exitCode, forKey: .exitCode)
+        try c.encode(termination, forKey: .termination); try c.encode(durationMs, forKey: .durationMs)
+        try c.encode(timedOut, forKey: .timedOut); try c.encode(failureCode, forKey: .failureCode)
+    }
+    var cliExitCode: Int32 {
+        switch termination { case .normal: exitCode ?? 1; case .timeout: 124; case .signal, .launchFailure: 1 }
+    }
+}
+enum BoundedProcessError: Error { case invalidCommand, outputUnavailable, childControl }
+
+enum BoundedProcess {
+    /// Every consuming CLI must call this before its ordinary option parsing.
+    /// fd0 is a private full-duplex launch socket only until exec; target stdin is /dev/null.
+    static func dispatchChildIfNeeded(arguments: [String]) throws {
+        guard arguments.first == "--bounded-child" else { return }
+        guard arguments.count >= 3, arguments[1] == "--" else { throw BoundedProcessError.childControl }
+        var type: Int32 = 0; var length = socklen_t(MemoryLayout<Int32>.size)
+        guard getsockopt(STDIN_FILENO, SOL_SOCKET, SO_TYPE, &type, &length) == 0, type == SOCK_STREAM else {
+            throw BoundedProcessError.childControl
+        }
+        let control = fcntl(STDIN_FILENO, F_DUPFD_CLOEXEC, 3)
+        guard control >= 0 else { throw BoundedProcessError.childControl }
+        defer { close(control) }
+        guard setpgid(0, 0) == 0 else { throw BoundedProcessError.childControl }
+        let ready = Array("READY \(getpid())\n".utf8)
+        guard ready.withUnsafeBytes({ Darwin.write(control, $0.baseAddress, $0.count) }) == ready.count else { throw BoundedProcessError.childControl }
+        let null = open("/dev/null", O_RDONLY)
+        guard null >= 0 else { throw BoundedProcessError.childControl }
+        guard dup2(null, STDIN_FILENO) >= 0 else { close(null); throw BoundedProcessError.childControl }
+        if null != STDIN_FILENO { close(null) }
+        let target = Array(arguments.dropFirst(2))
+        let strings = target.map { strdup($0) }
+        defer { for string in strings { free(string) } }
+        var argv = strings + [nil]
+        argv.withUnsafeMutableBufferPointer { buffer in _ = execv(target[0], buffer.baseAddress!) }
+        let failure = Array("EXECFAIL\n".utf8)
+        _ = failure.withUnsafeBytes { Darwin.write(control, $0.baseAddress, $0.count) }
+        throw BoundedProcessError.childControl
+    }
+
+    /// Synchronous, external process watchdog. No target actor/run loop participates in its deadline.
+    static func run(_ command: BoundedCommand, runnerExecutableURL: URL? = nil) throws -> BoundedResult {
+        guard command.timeoutSeconds.isFinite, command.timeoutSeconds > 0,
+              command.stdoutURL.standardizedFileURL != command.stderrURL.standardizedFileURL,
+              !([command.executable.path] + command.arguments).contains(where: { $0.utf8.contains(0) }) else {
+            throw BoundedProcessError.invalidCommand
+        }
+        let started = DispatchTime.now().uptimeNanoseconds
+        func elapsed() -> Double { Double(DispatchTime.now().uptimeNanoseconds - started) / 1_000_000_000 }
+        func result(_ termination: BoundedTermination, _ failure: BoundedFailure?, _ exit: Int32? = nil) -> BoundedResult {
+            BoundedResult(schemaVersion: 1, exitCode: exit, termination: termination, durationMs: Int(elapsed() * 1000),
+                          timedOut: termination == .timeout, failureCode: failure)
+        }
+        let fm = FileManager.default
+        try Data().write(to: command.stdoutURL, options: .withoutOverwriting)
+        try Data().write(to: command.stderrURL, options: .withoutOverwriting)
+        let stdout = try FileHandle(forWritingTo: command.stdoutURL)
+        let stderr = try FileHandle(forWritingTo: command.stderrURL)
+        defer { try? stdout.close(); try? stderr.close() }
+        guard fm.isExecutableFile(atPath: command.executable.path) else { return result(.launchFailure, .launchFailed) }
+        var sockets: [Int32] = [-1, -1]
+        guard socketpair(AF_UNIX, SOCK_STREAM, 0, &sockets) == 0 else { throw BoundedProcessError.childControl }
+        let parent = sockets[0]
+        let input = FileHandle(fileDescriptor: sockets[1], closeOnDealloc: true)
+        defer { close(parent); try? input.close() }
+        _ = fcntl(parent, F_SETFD, FD_CLOEXEC)
+        _ = fcntl(parent, F_SETFL, O_NONBLOCK)
+        let process = Process()
+        process.executableURL = runnerExecutableURL ?? URL(fileURLWithPath: CommandLine.arguments[0]).standardizedFileURL
+        process.arguments = ["--bounded-child", "--", command.executable.path] + command.arguments
+        process.currentDirectoryURL = command.workingDirectory
+        process.environment = command.environment
+        process.standardInput = input; process.standardOutput = stdout; process.standardError = stderr
+        do { try process.run() } catch { return result(.launchFailure, .launchFailed) }
+        try input.close()
+        let pid = process.processIdentifier
+        var ready = false
+        func groupExists() -> Bool { kill(-pid, 0) == 0 || errno == EPERM }
+        func stopOwned() -> Bool {
+            // A handshake grants group ownership. Before it, verify this exact child's group.
+            let ownGroup = pid > 1 && pid != getpgrp() && (ready || getpgid(pid) == pid)
+            let target = ownGroup ? -pid : pid
+            if process.isRunning || (ownGroup && groupExists()) { kill(target, SIGTERM) }
+            let grace = elapsed() + 2
+            while elapsed() < grace && (process.isRunning || (ownGroup && groupExists())) { Thread.sleep(forTimeInterval: 0.01) }
+            if process.isRunning || (ownGroup && groupExists()) { kill(target, SIGKILL) }
+            let reap = elapsed() + 1
+            while elapsed() < reap && (process.isRunning || (ownGroup && groupExists())) { Thread.sleep(forTimeInterval: 0.01) }
+            return !process.isRunning && (!ownGroup || !groupExists())
+        }
+        var received = Data()
+        var execConfirmed = false
+        let handshakeLimit = min(command.timeoutSeconds, 5)
+        while elapsed() < handshakeLimit {
+            var buffer = [UInt8](repeating: 0, count: 256)
+            let count = Darwin.read(parent, &buffer, buffer.count)
+            if count > 0 {
+                received.append(contentsOf: buffer.prefix(count))
+                if received.count > 512 { break }
+                ready = String(decoding: received, as: UTF8.self).hasPrefix("READY \(pid)\n")
+                if String(decoding: received, as: UTF8.self).contains("EXECFAIL") { break }
+            } else if count == 0 {
+                execConfirmed = received == Data("READY \(pid)\n".utf8)
+                break
+            } else if errno != EAGAIN && errno != EINTR { break }
+            else { Thread.sleep(forTimeInterval: 0.005) }
+        }
+        guard ready, execConfirmed else {
+            let clean = stopOwned()
+            return result(.launchFailure, !clean ? .cleanupFailed : String(decoding: received, as: UTF8.self).contains("EXECFAIL") ? .launchFailed : .handshakeFailed)
+        }
+        while process.isRunning && elapsed() < command.timeoutSeconds { Thread.sleep(forTimeInterval: 0.01) }
+        if process.isRunning {
+            let clean = stopOwned()
+            return result(.timeout, clean ? .deadlineExceeded : .cleanupFailed)
+        }
+        let reason = process.terminationReason
+        let status = process.terminationStatus
+        // A normally exiting parent may leave helpers in this owned group; clean that group too.
+        guard stopOwned() else { return result(.launchFailure, .cleanupFailed) }
+        if reason == .uncaughtSignal { return result(.signal, .childSignaled) }
+        return result(.normal, status == 0 ? nil : .childFailed, status)
+    }
+}
diff --git a/scripts/verification/ProcessCLI.swift b/scripts/verification/ProcessCLI.swift
new file mode 100644
index 0000000..5da8c23
--- /dev/null
+++ b/scripts/verification/ProcessCLI.swift
@@ -0,0 +1,40 @@
+import Foundation
+import Darwin
+
+@main
+enum ProcessCLI {
+    static func main() {
+        let arguments = Array(CommandLine.arguments.dropFirst())
+        do { try BoundedProcess.dispatchChildIfNeeded(arguments: arguments) }
+        catch { FileHandle.standardError.write(Data("FlowType runner: child control failed\n".utf8)); exit(125) }
+        if ProcessRunnerSelfTests.fixture(arguments: arguments) { return }
+        if arguments == ["--self-test"] { exit(ProcessRunnerSelfTests.run()) }
+        var timeout: Double?; var stdout: String?; var stderr: String?; var report: String?; var target: [String] = []
+        var index = 0
+        while index < arguments.count {
+            if arguments[index] == "--" { target = Array(arguments.dropFirst(index + 1)); break }
+            guard index + 1 < arguments.count else { exit(64) }
+            let value = arguments[index + 1]
+            switch arguments[index] {
+            case "--timeout": guard timeout == nil, let number = Double(value), number.isFinite, number > 0 else { exit(64) }; timeout = number
+            case "--stdout": guard stdout == nil else { exit(64) }; stdout = value
+            case "--stderr": guard stderr == nil else { exit(64) }; stderr = value
+            case "--result": guard report == nil else { exit(64) }; report = value
+            default: exit(64)
+            }
+            index += 2
+        }
+        guard let timeout, let stdout, let stderr, let report, !target.isEmpty else { exit(64) }
+        let reportURL = URL(fileURLWithPath: report).standardizedFileURL
+        guard reportURL != URL(fileURLWithPath: stdout).standardizedFileURL,
+              reportURL != URL(fileURLWithPath: stderr).standardizedFileURL else { exit(64) }
+        do {
+            guard !FileManager.default.fileExists(atPath: reportURL.path) else { throw BoundedProcessError.outputUnavailable }
+            let result = try BoundedProcess.run(BoundedCommand(executable: URL(fileURLWithPath: target[0]), arguments: Array(target.dropFirst()),
+                workingDirectory: URL(fileURLWithPath: FileManager.default.currentDirectoryPath), environment: ProcessInfo.processInfo.environment,
+                stdoutURL: URL(fileURLWithPath: stdout), stderrURL: URL(fileURLWithPath: stderr), timeoutSeconds: timeout))
+            try JSONEncoder().encode(result).write(to: reportURL, options: .withoutOverwriting)
+            exit(result.cliExitCode)
+        } catch { FileHandle.standardError.write(Data("FlowType runner: tool failure\n".utf8)); exit(125) }
+    }
+}
diff --git a/scripts/verification/ProcessRunnerSelfTests.swift b/scripts/verification/ProcessRunnerSelfTests.swift
new file mode 100644
index 0000000..12db5f4
--- /dev/null
+++ b/scripts/verification/ProcessRunnerSelfTests.swift
@@ -0,0 +1,105 @@
+import Foundation
+import Darwin
+
+enum ProcessRunnerSelfTests {
+    private static func spawn(_ executable: String, _ arguments: [String]) -> pid_t {
+        let strings = ([executable] + arguments).map { strdup($0) }
+        defer { for string in strings { free(string) } }
+        var argv = strings + [nil]
+        var pid: pid_t = 0
+        var environment: [UnsafeMutablePointer<CChar>?] = [nil]
+        let status = argv.withUnsafeMutableBufferPointer { buffer in
+            environment.withUnsafeMutableBufferPointer { values in
+                posix_spawn(&pid, executable, nil, nil, buffer.baseAddress!, values.baseAddress!)
+            }
+        }
+        precondition(status == 0)
+        return pid
+    }
+
+    static func fixture(arguments: [String]) -> Bool {
+        guard arguments.first == "--fixture", arguments.count >= 2 else { return false }
+        switch arguments[1] {
+        case "signal": raise(SIGKILL)
+        case "output": FileHandle.standardOutput.write(Data(repeating: 65, count: 2 * 1024 * 1024)); exit(23)
+        case "descendants", "grandchild":
+            signal(SIGTERM, SIG_IGN)
+            if arguments[1] == "descendants" {
+                let child = spawn(CommandLine.arguments[0], ["--fixture", "grandchild", arguments[2]])
+                try! Data("\(getpid())\n\(child)\n".utf8).write(to: URL(fileURLWithPath: arguments[2]))
+            } else {
+                let child = spawn("/bin/sleep", ["30"])
+                let url = URL(fileURLWithPath: arguments[2] + ".grandchild")
+                try! Data("\(child)".utf8).write(to: url)
+            }
+            while true { pause() }
+        case "blocked", "independent": while true { pause() }
+        default: exit(64)
+        }
+        exit(0)
+    }
+
+    static func run() -> Int32 {
+        var passed = 0; var failed = 0
+        func check(_ value: Bool, _ name: String) { if value { passed += 1 } else { failed += 1; print("FAIL: \(name)") } }
+        let fm = FileManager.default
+        let root = fm.temporaryDirectory.resolvingSymlinksInPath().appendingPathComponent("flowtype-process-\(UUID())")
+        do {
+            try fm.createDirectory(at: root, withIntermediateDirectories: true)
+            defer { try? fm.removeItem(at: root) }
+            let own = URL(fileURLWithPath: CommandLine.arguments[0]).standardizedFileURL
+            var sequence = 0
+            func command(_ args: [String], timeout: Double = 0.4, executable: URL? = nil) -> BoundedCommand {
+                sequence += 1
+                return BoundedCommand(executable: executable ?? own, arguments: args, workingDirectory: root, environment: [:],
+                    stdoutURL: root.appendingPathComponent("stdout-\(sequence)"), stderrURL: root.appendingPathComponent("stderr-\(sequence)"), timeoutSeconds: timeout)
+            }
+            let independent = Process(); independent.executableURL = own; independent.arguments = ["--fixture", "independent"]
+            independent.standardInput = FileHandle.nullDevice; independent.standardOutput = FileHandle.nullDevice; independent.standardError = FileHandle.nullDevice
+            try independent.run()
+            defer { if independent.isRunning { kill(independent.processIdentifier, SIGKILL) } }
+            let blocked = try BoundedProcess.run(command(["--fixture", "blocked"]))
+            check(blocked.timedOut && blocked.termination == .timeout && blocked.durationMs < 5000, "blocked main times out without unbounded wait")
+            check(blocked.cliExitCode == 124, "timeout CLI status124")
+            let signaled = try BoundedProcess.run(command(["--fixture", "signal"], timeout: 3))
+            check(signaled.termination == .signal && !signaled.timedOut, "signal exit is failure")
+            check(signaled.cliExitCode == 1 && signaled.failureCode == .childSignaled, "signal CLI failure status")
+            let outputCommand = command(["--fixture", "output"], timeout: 3)
+            let output = try BoundedProcess.run(outputCommand)
+            check(output.termination == .normal && output.exitCode == 23, "normal child exit status preserved")
+            check(try Data(contentsOf: outputCommand.stdoutURL).count == 2 * 1024 * 1024, "large stdout fully drained to file")
+            check(output.cliExitCode == 23, "CLI preserves normal nonzero child status")
+            let inputCommand = command([], timeout: 3, executable: URL(fileURLWithPath: "/bin/cat"))
+            let input = try BoundedProcess.run(inputCommand)
+            check(input.cliExitCode == 0 && input.failureCode == nil, "normal successful CLI status0")
+            check(try Data(contentsOf: inputCommand.stdoutURL).isEmpty, "target stdin is closed /dev/null")
+            let successJSON = try JSONSerialization.jsonObject(with: JSONEncoder().encode(input)) as! [String: Any]
+            check(successJSON["failureCode"] is NSNull, "successful result failure is explicit null")
+            let literal = "literal spaces; $(touch forbidden)"
+            let literalCommand = command(["%s", literal], timeout: 3, executable: URL(fileURLWithPath: "/usr/bin/printf"))
+            let literalResult = try BoundedProcess.run(literalCommand)
+            check(try literalResult.exitCode == 0 && String(contentsOf: literalCommand.stdoutURL, encoding: .utf8) == literal,
+                  "arguments remain literal without shell evaluation")
+            let pids = root.appendingPathComponent("descendants.pid")
+            let descendants = try BoundedProcess.run(command(["--fixture", "descendants", pids.path], timeout: 1))
+            var owned: [pid_t] = []
+            if let text = try? String(contentsOf: pids, encoding: .utf8) { owned += text.split(separator: "\n").compactMap { Int32($0) } }
+            if let text = try? String(contentsOf: URL(fileURLWithPath: pids.path + ".grandchild"), encoding: .utf8), let pid = Int32(text) { owned.append(pid) }
+            defer { for pid in owned where kill(pid, 0) == 0 { kill(pid, SIGKILL) } }
+            check(descendants.timedOut && descendants.durationMs >= 2900 && descendants.durationMs < 6000, "TERM grace then bounded KILL")
+            let deadline = Date().addingTimeInterval(1)
+            while Date() < deadline && owned.contains(where: { kill($0, 0) == 0 }) { Thread.sleep(forTimeInterval: 0.02) }
+            if owned.contains(where: { kill($0, 0) == 0 }) { print("owned fixture states: " + owned.map { "pid=\($0) group=\(getpgid($0)) alive=\(kill($0, 0) == 0)" }.joined(separator: "; ")) }
+            check(owned.count == 3 && owned.allSatisfy { kill($0, 0) == -1 && errno == ESRCH }, "all owned descendants terminated")
+            check(independent.isRunning, "independent fixture survives other group cleanup")
+            let missing = try BoundedProcess.run(command([], executable: root.appendingPathComponent("missing")))
+            check(missing.termination == .launchFailure && missing.failureCode != nil, "missing executable is closed launch failure")
+            let handshake = try BoundedProcess.run(command(["--fixture", "blocked"]), runnerExecutableURL: URL(fileURLWithPath: "/usr/bin/true"))
+            check(handshake.termination == .launchFailure && handshake.failureCode == .handshakeFailed && !handshake.timedOut, "missing child handshake fails without launching target")
+            let encoded = try JSONSerialization.jsonObject(with: JSONEncoder().encode(output)) as! [String: Any]
+            check(encoded["timedOut"] as? Bool == false, "result is Codable")
+        } catch { check(false, "process fixture operation failed") }
+        print("=== process runner self-test: \(passed) passed, \(failed) failed ===")
+        return failed == 0 ? 0 : 1
+    }
+}
