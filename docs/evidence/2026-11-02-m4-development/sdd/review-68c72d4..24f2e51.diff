diff --git a/Sources/flowtype/Services/RecordingEngineStartup.swift b/Sources/flowtype/Services/RecordingEngineStartup.swift
new file mode 100644
index 0000000..2d06fe2
--- /dev/null
+++ b/Sources/flowtype/Services/RecordingEngineStartup.swift
@@ -0,0 +1,13 @@
+/// Synchronous engine boundary: every startup failure signals interruption before
+/// ending the spectrum stream, so it cannot look like a successful empty capture.
+enum RecordingEngineStartup {
+    static func run(prepare: () -> Void, start: () throws -> Void,
+                    onFailure: () -> Void, finish: () -> Void) {
+        prepare()
+        do { try start() }
+        catch {
+            onFailure()
+            finish()
+        }
+    }
+}
